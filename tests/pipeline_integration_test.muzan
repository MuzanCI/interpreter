# pyright: ignore
j1 = Job(
    name = "j1",
    uses = Image(
        ref = "freebsd/freebsd-toolchain:15.0",
        arch = "arm64",
        os = "freebsd",
    ),
    steps = [
        Step(
            name = "step1",
            command = "echo 'Hello, World!'",
        )
    ],
)

p1 = Pipeline(
    name = "pipeline1",
    needs = [j1],
)
